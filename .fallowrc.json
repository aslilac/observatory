{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"site/index.html",
		"src/main/index.ts",
		"src/preload/index.ts",
		"src/renderer/index.html",
		"src/renderer/views/about/about.html"
	],
	"duplicates": {
		"mode": "semantic",
		"ignoreImports": true,
		"threshold": 1.5
	},
	"health": {
		"maxCyclomatic": 20,
		"maxCognitive": 20,
		"maxCrap": 1000
	}
}
