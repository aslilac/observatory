{
	"extends": "@mckayla/tsconfig",
	"compilerOptions": {
		"lib": ["dom", "esnext"],
		"module": "commonjs",
		"moduleResolution": "node10",
		"outDir": "build/",
		"target": "esnext",
		"noUnusedLocals": false,
		"skipLibCheck": true,
		"verbatimModuleSyntax": false
	},
	"include": ["./src/**/*"]
}
