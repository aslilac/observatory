{
	"name": "observatory",
	"version": "0.10.0",
	"description": "Disk usage analyzer",
	"private": true,
	"main": "./build/main/index.js",
	"author": "McKayla Washburn <mckayla@hey.com>",
	"license": "MIT",
	"repository": "https://github.com/aslilac/observatory",
	"bugs": "https://github.com/aslilac/observatory/issues",
	"targets": {
		"renderer": {
			"context": "browser",
			"publicUrl": ".",
			"distDir": "./build/renderer",
			"engines": {
				"electron": ">= 41.x.x"
			}
		}
	},
	"config": {
		"forge": "forge.config.js"
	},
	"dependencies": {
		"@fontsource/montserrat": "^5.2.8",
		"@fontsource/roboto-mono": "^5.2.8",
		"@fontsource/roboto-slab": "^5.2.8",
		"drivelist": "^12.0.2",
		"electron-squirrel-startup": "^1.0.1",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@electron-forge/cli": "^7.11.1",
		"@electron-forge/maker-dmg": "^7.11.1",
		"@electron-forge/maker-squirrel": "^7.11.1",
		"@electron-forge/maker-zip": "^7.11.1",
		"@electron/rebuild": "^4.0.4",
		"@tailwindcss/postcss": "^4.2.4",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^9.1.0",
		"electron": "^41.5.0",
		"electron-build-env": "^0.2.0",
		"esbuild": "^0.28.0",
		"nodemon": "^3.1.7",
		"parcel": "^2.13.3",
		"prettier": "~3.8.3",
		"tailwindcss": "^4.2.4",
		"typescript": "~5.7.2",
		"vitest": "^4.1.5"
	},
	"scripts": {
		"configure": "electron-rebuild -f -w drivelist",
		"build": "npm run build:main && npm run build:preload && npm run build:renderer",
		"build:main": "tsc -p tsconfig.build.json",
		"build:preload": "esbuild --bundle --external:electron --format=cjs --outfile=build/preload.js ./src/preload/index.ts",
		"build:renderer": "parcel build --target renderer ./src/renderer/index.html ./src/renderer/about.html",
		"dev": "concurrently 'npm run dev:main' 'npm run dev:preload' 'npm run dev:renderer' 'nodemon'",
		"dev:main": "tsc -p tsconfig.build.json -w -preserveWatchOutput",
		"dev:preload": "esbuild --watch --bundle --external:electron --format=cjs --outfile=build/preload.js ./src/preload/index.ts",
		"dev:renderer": "parcel watch --target renderer ./src/renderer/index.html ./src/renderer/about.html",
		"fmt": "prettier --ignore-path .gitignore --write .",
		"forge": "npm run build && electron-forge make",
		"test": "vitest run",
		"test:watch": "vitest",
		"type-check": "tsc -p . --noEmit"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
